{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lextari-auth",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-03",
	"workers_dev": false,
	"preview_urls": false,
	"observability": { "enabled": true },
  "routes": [
    { "pattern": "lextari-auth.danialsanusi.com", "custom_domain": true }
  ],
	"vars": {
		"JWT_ISSUER": "lextari-auth",
		"JWT_AUDIENCE": "lextari-app",
		"SESSION_TTL_SECONDS": 43200,
		"ARGON2_MEMORY_KIB": 19456,
		"ARGON2_TIME_COST": 2,
		"MAX_JSON_BYTES": 16384,
		"CORS_ORIGINS": "http://localhost:3000"
	},
	"secrets": {
		"required": ["JWT_PRIVATE_JWK", "JWT_PUBLIC_JWKS", "PASSWORD_PEPPER"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "lextari",
			"database_id": "cddd5fd9-ec50-4589-ad79-f2f066029d50",
			"migrations_dir": "migrations"
		}
	],
	"ratelimits": [
		{ "name": "LOGIN_LIMITER", "namespace_id": "2001", "simple": { "limit": 5, "period": 60 } }
	]
}
