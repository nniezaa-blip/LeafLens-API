{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lextari-api",
  "main": "src/worker.py",
  "compatibility_date": "2026-11-03",
  "compatibility_flags": ["python_workers"],
  "observability": {
    "enabled": true
  },
  "routes": [
    { "pattern": "lextari-api.danialsanusi.com", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lextari",
      "database_id": "cddd5fd9-ec50-4589-ad79-f2f066029d50",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "TB_URL": "https://tb.example.com",
    "AUTH_JWKS_URL": "https://lextari-auth.danialsanusi.com/.well-known/jwks.json",
    "AUTH_ISSUER": "lextari-auth",
    "AUTH_AUDIENCE": "lextari-app",
    "DEBUG": "false",
    "CORS_ORIGINS": "http://localhost:3000",
    "WS_POLL_INTERVAL": "5"
  }
}
